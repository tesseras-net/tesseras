post_install() {
    echo ":: To use the CLI without sudo, add your user to the tesseras group:"
    echo "     sudo usermod -aG tesseras \$USER"
    echo "   Then log out and back in for the change to take effect."
    echo ""
    echo ":: To start the daemon:"
    echo "     sudo systemctl enable --now tesd"
}

post_upgrade() {
    post_install
}
