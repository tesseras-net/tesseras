# Maintainer: tesseras maintainers
pkgname=tesseras
pkgver=0.1.0
pkgrel=0
pkgdesc="P2P network for preserving human memories across millennia"
url="https://tesseras.net"
arch="x86_64 aarch64"
license="ISC"
depends="sqlite-libs"
makedepends="cargo sqlite-dev"
install="$pkgname.pre-install $pkgname.post-install"
source=""

_root="${TESSERAS_ROOT:?Set TESSERAS_ROOT or use just alpine}"

prepare() {
    export RUSTUP_TOOLCHAIN=stable
    cd "$_root"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cd "$_root"
    cargo build --frozen --release -p tesseras-daemon -p tesseras-cli
}

package() {
    # Binaries
    install -Dm755 "$srcdir/target/release/tesd" "$pkgdir/usr/bin/tesd"
    install -Dm755 "$srcdir/target/release/tes" "$pkgdir/usr/bin/tes"

    # Config (reuse Debian default)
    install -Dm644 "$_root/packaging/debian/tesd.default.toml" "$pkgdir/etc/tesseras/config.toml"

    # OpenRC init script
    install -Dm755 "$_root/packaging/alpine/tesd.initd" "$pkgdir/etc/init.d/tesd"

    # OpenRC conf.d
    install -Dm644 "$_root/packaging/alpine/tesd.confd" "$pkgdir/etc/conf.d/tesd"

    # Shell completions
    "$srcdir/target/release/tes" completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/tes"
    "$srcdir/target/release/tes" completions zsh  | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_tes"
    "$srcdir/target/release/tes" completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/tes.fish"
}
